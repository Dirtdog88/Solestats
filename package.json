{
  "name": "solestats",
  "version": "0.1.0",
  "private": true,
  "description": "SoleStats: the running shoe AI index. A public index of how AI shopping assistants recommend, describe and route sales for running brands. Cloudflare Worker + D1, no build step.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "dev": "npx wrangler@4 dev",
    "preview": "node --disable-warning=ExperimentalWarning test/2026-11-21-local-server.js",
    "deploy": "npx wrangler@4 d1 migrations apply solestats --remote && npx wrangler@4 deploy",
    "seed": "node scripts/2026-11-21-seed.js",
    "run": "node --use-env-proxy --disable-warning=UNDICI-EHPA scripts/2026-11-21-run.js",
    "import": "node scripts/2026-11-21-import.js",
    "score": "node scripts/2026-11-21-score.js",
    "export": "node scripts/2026-11-21-export.js",
    "site-checks": "node scripts/2026-11-21-site-checks.js",
    "check-shoe-sources": "node scripts/2026-11-22-check-shoe-sources.js",
    "demand-signals": "node scripts/2026-11-22-demand-signals.js",
    "demand": "node scripts/2026-11-22-demand.js",
    "gel-queries": "node scripts/2026-11-23-gel-queries.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0"
  }
}
